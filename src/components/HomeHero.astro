---
/**
 * Homepage hero: "The Observation Field"
 * Idea: running a business is noise. Ethnoir's job is to bring it into focus.
 * A scatter of marks sits in the dark; a viewfinder lens follows the cursor and
 * the marks inside it align and light up. The copy is the approved Home hero copy, unchanged.
 * Performance: zero-render-blocking, immediate text visibility, ultra-fast canvas observation field.
 */
---

<section class="hero" aria-label="Introduction" data-hero>
  <canvas class="hero__field" aria-hidden="true" data-field></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 class="hero__title">
      <span class="hero__w">Better</span>{' '}
      <span class="hero__w">decisions</span>{' '}
      <span class="hero__w">start</span>{' '}
      <span class="hero__w">with</span>{' '}
      <span class="hero__w">a</span>{' '}
      <span class="hero__w">clear</span>{' '}
      <span class="hero__w">view</span>{' '}
      <span class="hero__w">of</span>{' '}
      <span class="hero__w">what</span>{' '}
      <span class="hero__w">is</span>{' '}
      <em class="hero__em">
        <span class="hero__w">really</span>{' '}
        <span class="hero__w">happening.</span>
        <svg class="hero__ul" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path
            d="M2 9 C 38 2, 72 13, 112 7 S 188 2, 228 8 S 282 11, 298 4"
            pathLength="1"
            vector-effect="non-scaling-stroke"></path>
        </svg>
      </em>
    </h1>

    <p class="hero__lede">
      Ethnoir helps founders see what deserves attention in their business, and helps organizations that support entrepreneurs understand what participants need and whether their programs fit.
    </p>

    <div class="hero__actions">
      <a href="/contact?type=institutional" class="hero__cta" data-cta>
        <span>Discuss an entrepreneurship-support challenge</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M3 10h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero__cue" aria-hidden="true"><span></span></div>
  <div class="hero__bar" aria-hidden="true">
    <i style="flex: 3; background: #1b8a8c"></i>
    <i style="flex: 1.2; background: #4fc1b8"></i>
    <i style="flex: 2; background: #f2b04a"></i>
    <i style="flex: 1; background: #e2694b"></i>
    <i style="flex: 0.6; background: #fffdf8"></i>
  </div>
</section>

<style>
  .hero {
    --ink-deep: #081820;
    --ink: #0a1e25;
    --sea: #4fc1b8;
    --amber: #f2b04a;
    --amber-hot: #ffc766;
    --coral: #e2694b;
    --porcelain: #fffdf8;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(31rem, calc(100svh - 5rem), 54rem);
    color: var(--porcelain);
    background:
      radial-gradient(70% 60% at 100% 100%, rgba(226, 105, 75, 0.16), transparent 62%),
      radial-gradient(60% 70% at 0% 0%, rgba(27, 138, 140, 0.2), transparent 60%),
      linear-gradient(160deg, #0f2c35 0%, var(--ink) 55%, var(--ink-deep) 100%);
  }

  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(8, 24, 32, 0.84) 0%,
      rgba(8, 24, 32, 0.62) 42%,
      rgba(8, 24, 32, 0) 78%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 8vh, 6rem) clamp(4rem, 10vh, 7rem);
  }

  .hero__title {
    margin: 0;
    max-width: 13.5em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.3rem, min(5.5vw, 9.2vh), 5.1rem);
    line-height: 1.04;
    letter-spacing: -0.026em;
    color: var(--porcelain);
    text-wrap: balance;
  }

  .hero__w {
    display: inline-block;
  }

  .hero__em {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    font-style: italic;
    color: var(--amber);
  }

  .hero__ul {
    position: absolute;
    left: 0;
    bottom: -0.16em;
    width: 100%;
    height: 0.26em;
    overflow: visible;
    pointer-events: none;
  }

  .hero__ul path {
    fill: none;
    stroke: var(--amber);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: hero-underline 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s backwards;
  }

  .hero__lede {
    max-width: 35em;
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 253, 248, 0.84);
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4.5vh, 2.75rem);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.95rem 1.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    text-decoration: none;
    color: var(--ink);
    background: var(--amber);
    box-shadow: 0 0 0 0 rgba(242, 176, 74, 0);
    will-change: transform;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      box-shadow 0.3s ease;
  }

  .hero__cta svg {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .hero__cta:hover {
    opacity: 1;
    background: var(--amber-hot);
    box-shadow: 0 14px 34px -10px rgba(242, 176, 74, 0.6);
  }

  .hero__cta:hover svg {
    transform: translateX(4px);
  }

  .hero__cta:focus-visible {
    outline: 3px solid var(--porcelain);
    outline-offset: 3px;
  }

  .hero__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    height: 6px;
    transform-origin: left center;
    animation: hero-bar-expand 1.1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hero__bar i {
    display: block;
    height: 100%;
  }

  .hero__cue {
    position: absolute;
    z-index: 3;
    bottom: 1.5rem;
    left: max(var(--page-gutter), calc((100% - 1200px) / 2 + var(--page-gutter)));
    width: 1px;
    height: 3rem;
    background: rgba(255, 253, 248, 0.22);
    overflow: hidden;
  }

  .hero__cue span {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--amber);
    animation: hero-cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-14px);
    }
    100% {
      transform: translateY(3.2rem);
    }
  }

  @keyframes hero-underline {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-bar-expand {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
      min-height: clamp(34rem, calc(100svh - 4.5rem), 48rem);
    }
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(8, 24, 32, 0.35) 0%,
        rgba(8, 24, 32, 0.72) 45%,
        rgba(8, 24, 32, 0.9) 100%
      );
    }
    .hero__cta {
      width: 100%;
      justify-content: space-between;
    }
    .hero__cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue span {
      animation: none;
    }
    .hero__cta,
    .hero__cta svg {
      transition: none;
    }
  }
</style>

<script>
  type RGB = [number, number, number];

  interface Mark {
    hx: number; // home (aligned) position
    hy: number;
    ox: number; // scatter offset
    oy: number;
    rot: number; // scatter rotation
    ph: number; // drift phase
    sp: number; // drift speed
    c: RGB; // lit colour
    t: number; // 0 = noise, 1 = clear
  }

  const PALETTE: { c: RGB; w: number }[] = [
    { c: [79, 193, 184], w: 0.58 }, // sea glass
    { c: [242, 176, 74], w: 0.2 }, // amber
    { c: [226, 105, 75], w: 0.08 }, // coral
    { c: [255, 253, 248], w: 0.14 }, // porcelain
  ];
  const MUTED: RGB = [118, 158, 164];

  const pickColor = (): RGB => {
    let r = Math.random();
    for (const p of PALETTE) {
      r -= p.w;
      if (r <= 0) return p.c;
    }
    return PALETTE[0].c;
  };
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  function initHero(hero: HTMLElement, canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    let w = 1;
    let h = 1;
    let dpr = 1;
    let baseR = 170;
    let marks: Mark[] = [];
    const lens = { x: 0, y: 0 };
    const intro = { v: reduced ? 1 : 0 };
    const target = { x: 0, y: 0 };
    let lastMove = -1e9;

    const idlePoint = (time: number) =>
      w < 760
        ? { x: w * 0.5 + Math.sin(time * 0.45) * w * 0.26, y: h * 0.3 + Math.sin(time * 0.31 + 1.2) * h * 0.1 }
        : { x: w * 0.7 + Math.sin(time * 0.45) * w * 0.12, y: h * 0.5 + Math.sin(time * 0.31 + 1.2) * h * 0.2 };

    function build() {
      const s = w < 760 ? 30 : 40;
      const cols = Math.ceil(w / s) + 2;
      const rows = Math.ceil(h / s) + 2;
      const x0 = (w - (cols - 1) * s) / 2;
      const y0 = (h - (rows - 1) * s) / 2;
      marks = [];
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const a = Math.random() * Math.PI * 2;
          const d = s * (0.5 + Math.random() * 1.5);
          marks.push({
            hx: x0 + i * s,
            hy: y0 + j * s,
            ox: Math.cos(a) * d,
            oy: Math.sin(a) * d,
            rot: Math.random() * Math.PI,
            ph: Math.random() * Math.PI * 2,
            sp: 0.5 + Math.random() * 0.9,
            c: pickColor(),
            t: 0,
          });
        }
      }
    }

    function draw(time: number, dt: number) {
      ctx!.clearRect(0, 0, w, h);
      const R = baseR * (1 - Math.pow(1 - intro.v, 3));
      const k = reduced ? 1 : 1 - Math.exp(-dt * 8);

      if (R > 1) {
        const bloom = ctx!.createRadialGradient(lens.x, lens.y, 0, lens.x, lens.y, R * 2.7);
        bloom.addColorStop(0, 'rgba(79,193,184,0.22)');
        bloom.addColorStop(0.5, 'rgba(27,138,140,0.09)');
        bloom.addColorStop(1, 'rgba(27,138,140,0)');
        ctx!.fillStyle = bloom;
        ctx!.fillRect(0, 0, w, h);

        const warm = ctx!.createRadialGradient(lens.x, lens.y, 0, lens.x, lens.y, R);
        warm.addColorStop(0, 'rgba(242,176,74,0.12)');
        warm.addColorStop(1, 'rgba(242,176,74,0)');
        ctx!.fillStyle = warm;
        ctx!.beginPath();
        ctx!.arc(lens.x, lens.y, R, 0, Math.PI * 2);
        ctx!.fill();
      }

      const inner = R * 0.6;
      ctx!.lineCap = 'round';
      for (const m of marks) {
        let tt = 0;
        if (R > 1) {
          const d = Math.hypot(m.hx - lens.x, m.hy - lens.y);
          tt = 1 - clamp((d - inner) / (R - inner), 0, 1);
          tt = tt * tt * (3 - 2 * tt);
        }
        m.t += (tt - m.t) * k;
        const t = m.t;
        const e = 1 - t;
        const x = m.hx + m.ox * e + Math.sin(time * m.sp + m.ph) * 7 * e;
        const y = m.hy + m.oy * e + Math.cos(time * m.sp * 0.83 + m.ph) * 7 * e;
        const rot = m.rot * e;
        const half = (4.5 + 8.5 * t) / 2;
        const cx = Math.cos(rot) * half;
        const cy = Math.sin(rot) * half;
        const r = Math.round(MUTED[0] + (m.c[0] - MUTED[0]) * t);
        const g = Math.round(MUTED[1] + (m.c[1] - MUTED[1]) * t);
        const b = Math.round(MUTED[2] + (m.c[2] - MUTED[2]) * t);
        ctx!.strokeStyle = `rgba(${r},${g},${b},${(0.2 + 0.75 * t).toFixed(3)})`;
        ctx!.lineWidth = 1.4 + 0.9 * t;
        ctx!.beginPath();
        ctx!.moveTo(x - cx, y - cy);
        ctx!.lineTo(x + cx, y + cy);
        ctx!.stroke();
      }

      if (R > 1) {
        const a = clamp(intro.v, 0, 1);
        // lens ring
        ctx!.lineWidth = 1;
        ctx!.strokeStyle = `rgba(255,253,248,${0.38 * a})`;
        ctx!.beginPath();
        ctx!.arc(lens.x, lens.y, R, 0, Math.PI * 2);
        ctx!.stroke();
        // graduated ticks, like a viewfinder dial
        for (let i = 0; i < 120; i++) {
          const ang = (i / 120) * Math.PI * 2;
          const major = i % 10 === 0;
          const mid = i % 5 === 0;
          const len = major ? 12 : mid ? 7 : 3.5;
          const r1 = R + 6;
          const r2 = r1 + len;
          ctx!.strokeStyle = `rgba(255,253,248,${(major ? 0.6 : 0.22) * a})`;
          ctx!.beginPath();
          ctx!.moveTo(lens.x + Math.cos(ang) * r1, lens.y + Math.sin(ang) * r1);
          ctx!.lineTo(lens.x + Math.cos(ang) * r2, lens.y + Math.sin(ang) * r2);
          ctx!.stroke();
        }
        // centre reticle
        ctx!.strokeStyle = `rgba(242,176,74,${0.9 * a})`;
        ctx!.lineWidth = 1.2;
        ctx!.beginPath();
        for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
          ctx!.moveTo(lens.x + dx * 6, lens.y + dy * 6);
          ctx!.lineTo(lens.x + dx * 13, lens.y + dy * 13);
        }
        ctx!.stroke();
        ctx!.fillStyle = `rgba(242,176,74,${a})`;
        ctx!.beginPath();
        ctx!.arc(lens.x, lens.y, 2.2, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function resize() {
      const rect = hero.getBoundingClientRect();
      w = Math.max(1, rect.width);
      h = Math.max(1, rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      baseR = w < 760 ? 118 : clamp(w * 0.14, 150, 210);
      build();
      const p = idlePoint(0);
      lens.x = target.x = p.x;
      lens.y = target.y = p.y;
      if (reduced) draw(0, 1);
    }

    resize();
    new ResizeObserver(resize).observe(hero);

    // ---- Static path: render one calm frame and stop.
    if (reduced) return;

    // ---- Live path
    let running = false;
    let inView = true;
    let raf = 0;
    let last = performance.now();

    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const time = now / 1000;
      if (intro.v < 1) {
        intro.v = Math.min(1, intro.v + dt * 0.85);
      }
      const active = now - lastMove < 2500;
      const tgt = active ? target : idlePoint(time);
      const f = 1 - Math.exp(-dt * (active ? 7 : 3));
      lens.x += (tgt.x - lens.x) * f;
      lens.y += (tgt.y - lens.y) * f;
      draw(time, dt);
      if (running) raf = requestAnimationFrame(frame);
    }
    const start = () => {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        inView && !document.hidden ? start() : stop();
      },
      { threshold: 0 },
    ).observe(hero);
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : inView && start();
    });

    hero.addEventListener(
      'pointermove',
      (e) => {
        const r = canvas.getBoundingClientRect();
        target.x = e.clientX - r.left;
        target.y = e.clientY - r.top;
        lastMove = performance.now();
      },
      { passive: true },
    );
    hero.addEventListener('pointerleave', () => {
      lastMove = -1e9;
    });

    start();

    // CTA cursor magnet with hardware-accelerated spring
    const cta = hero.querySelector<HTMLElement>('[data-cta]');
    if (finePointer && cta) {
      initMagnet(cta);
    }
  }

  function initMagnet(el: HTMLElement) {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - (r.left + r.width / 2)) * 0.12;
      const y = (e.clientY - (r.top + r.height / 2)) * 0.25;
      el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    });
    el.addEventListener('pointerleave', () => {
      el.style.transform = 'translate3d(0, 0, 0)';
    });
  }

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-field]');
  if (hero && canvas) initHero(hero, canvas);
</script>
