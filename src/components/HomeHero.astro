---
/**
 * Homepage hero: "The Observation Field"
 * Idea: running a business is noise. Ethnoir's job is to bring it into focus.
 * A scatter of marks sits in the dark; a viewfinder lens follows the cursor and
 * the marks inside it align and light up. The copy is the approved Home hero copy, unchanged.
 * Performance: zero-render-blocking, immediate text visibility, ultra-fast canvas observation field.
 */
---

<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero__bg-wrap" aria-hidden="true">
    <picture>
      <source srcset="/images/hero-bg.webp" type="image/webp" />
      <img
        src="/images/hero-bg.jpg"
        alt=""
        class="hero__bg-img"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__inner">
    <h1 class="hero__title">
      <span class="hero__w">Better</span>{' '}
      <span class="hero__w">decisions</span>{' '}
      <span class="hero__w">start</span>{' '}
      <span class="hero__w">with</span>{' '}
      <span class="hero__w">a</span>{' '}
      <span class="hero__w">clear</span>{' '}
      <span class="hero__w">view</span>{' '}
      <span class="hero__w">of</span>{' '}
      <span class="hero__w">what</span>{' '}
      <span class="hero__w">is</span>{' '}
      <em class="hero__em">
        <span class="hero__w">really</span>{' '}
        <span class="hero__w">happening.</span>
        <svg class="hero__ul" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path
            d="M2 9 C 38 2, 72 13, 112 7 S 188 2, 228 8 S 282 11, 298 4"
            pathLength="1"
            vector-effect="non-scaling-stroke"></path>
        </svg>
      </em>
    </h1>

    <p class="hero__lede">
      Ethnoir helps founders work out what deserves attention and helps entrepreneurship-support organizations connect participant needs with practical decisions about what support to offer, how to deliver it and what to measure.
    </p>

    <div class="hero__actions">
      <a href="/contact?type=institutional" class="hero__cta" data-cta>
        <span>Discuss an entrepreneurship-support challenge</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M3 10h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero__cue" aria-hidden="true"><span></span></div>
  <div class="hero__bar" aria-hidden="true">
    <i style="flex: 3; background: #1b8a8c"></i>
    <i style="flex: 1.2; background: #4fc1b8"></i>
    <i style="flex: 2; background: #f2b04a"></i>
    <i style="flex: 1; background: #e2694b"></i>
    <i style="flex: 0.6; background: #fffdf8"></i>
  </div>
</section>

<style>
  .hero {
    --ink-deep: #081820;
    --ink: #0a1e25;
    --sea: #4fc1b8;
    --amber: #f2b04a;
    --amber-hot: #ffc766;
    --coral: #e2694b;
    --porcelain: #fffdf8;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(31rem, calc(100svh - 5rem), 54rem);
    color: var(--porcelain);
    background:
      radial-gradient(70% 60% at 100% 100%, rgba(226, 105, 75, 0.16), transparent 62%),
      radial-gradient(60% 70% at 0% 0%, rgba(27, 138, 140, 0.2), transparent 60%),
      linear-gradient(160deg, #0f2c35 0%, var(--ink) 55%, var(--ink-deep) 100%);
  }

  .hero__bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.38;
    filter: saturate(0.9) brightness(0.92);
    transform: scale(1.02);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(8, 24, 32, 0.95) 0%,
        rgba(8, 24, 32, 0.88) 36%,
        rgba(8, 24, 32, 0.52) 68%,
        rgba(8, 24, 32, 0.68) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 24, 32, 0.45) 0%,
        transparent 20%,
        transparent 75%,
        rgba(8, 24, 32, 0.85) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 8vh, 6rem) clamp(4rem, 10vh, 7rem);
  }

  .hero__title {
    margin: 0;
    max-width: 13.5em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.3rem, min(5.5vw, 9.2vh), 5.1rem);
    line-height: 1.04;
    letter-spacing: -0.026em;
    color: var(--porcelain);
    text-wrap: balance;
  }

  .hero__w {
    display: inline-block;
  }

  .hero__em {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    font-style: italic;
    color: var(--amber);
  }

  .hero__ul {
    position: absolute;
    left: 0;
    bottom: -0.16em;
    width: 100%;
    height: 0.26em;
    overflow: visible;
    pointer-events: none;
  }

  .hero__ul path {
    fill: none;
    stroke: var(--amber);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: hero-underline 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s backwards;
  }

  .hero__lede {
    max-width: 35em;
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 253, 248, 0.84);
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4.5vh, 2.75rem);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.95rem 1.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    text-decoration: none;
    color: var(--ink);
    background: var(--amber);
    box-shadow: 0 0 0 0 rgba(242, 176, 74, 0);
    will-change: transform;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      box-shadow 0.3s ease;
  }

  .hero__cta svg {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .hero__cta:hover {
    opacity: 1;
    background: var(--amber-hot);
    box-shadow: 0 14px 34px -10px rgba(242, 176, 74, 0.6);
  }

  .hero__cta:hover svg {
    transform: translateX(4px);
  }

  .hero__cta:focus-visible {
    outline: 3px solid var(--porcelain);
    outline-offset: 3px;
  }

  .hero__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    height: 6px;
    transform-origin: left center;
    animation: hero-bar-expand 1.1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hero__bar i {
    display: block;
    height: 100%;
  }

  .hero__cue {
    position: absolute;
    z-index: 3;
    bottom: 1.5rem;
    left: max(var(--page-gutter), calc((100% - 1200px) / 2 + var(--page-gutter)));
    width: 1px;
    height: 3rem;
    background: rgba(255, 253, 248, 0.22);
    overflow: hidden;
  }

  .hero__cue span {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--amber);
    animation: hero-cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-14px);
    }
    100% {
      transform: translateY(3.2rem);
    }
  }

  @keyframes hero-underline {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-bar-expand {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
      min-height: clamp(34rem, calc(100svh - 4.5rem), 48rem);
    }
    .hero__bg-img {
      object-position: 75% center;
      opacity: 0.28;
    }
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(8, 24, 32, 0.45) 0%,
        rgba(8, 24, 32, 0.82) 42%,
        rgba(8, 24, 32, 0.96) 100%
      );
    }
    .hero__cta {
      width: 100%;
      justify-content: space-between;
    }
    .hero__cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue span {
      animation: none;
    }
    .hero__cta,
    .hero__cta svg {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const cta = hero?.querySelector<HTMLElement>('[data-cta]');
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (finePointer && cta) {
    cta.addEventListener('pointermove', (e) => {
      const r = cta.getBoundingClientRect();
      const x = (e.clientX - (r.left + r.width / 2)) * 0.12;
      const y = (e.clientY - (r.top + r.height / 2)) * 0.25;
      cta.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    });
    cta.addEventListener('pointerleave', () => {
      cta.style.transform = 'translate3d(0, 0, 0)';
    });
  }
</script>
