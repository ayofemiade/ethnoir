---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Ethnoir"
  description="Contact Ethnoir with a venture-development question, propose a collaboration, or request help with the Venture Readiness Check-In."
>
  <!-- SECTION A: OPENING -->
  <section class="bg-parchment" style="padding: var(--space-lg) 0 var(--space-xl) 0; border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12" style="margin-bottom: var(--space-sm);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em;">Contact</span>
      </div>
      
      <div class="col-12 md-col-9" style="margin-bottom: var(--space-lg);">
        <h1 class="voice-1" style="font-size: clamp(2.5rem, 6vw, 4.5rem); margin: 0; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-tidal-ink);">
          Contact Ethnoir
        </h1>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.25rem; line-height: 1.5; color: var(--color-deep-teal); margin-bottom: var(--space-sm);">
          Use this page to share a venture-development question, propose a collaboration, request help with the Venture Readiness Check-In or send a general inquiry.
        </p>
        <p class="voice-2" style="font-size: 1.125rem; line-height: 1.5; color: var(--color-tidal-ink); margin: 0;">
          Choose the option that best matches your reason for contacting Ethnoir. You only need to provide enough context for the inquiry to be understood and routed appropriately.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION B: INQUIRY TYPES -->
  <section class="bg-porcelain chapter chapter-large-spacing" style="border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Inquiry types</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">What would you like to contact Ethnoir about?</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <div class="inquiry-type-item">
          <h3 class="voice-1">Institutional or venture-development challenge</h3>
          <p class="voice-2">For organizations examining a question involving entrepreneurs, ventures, support programs, resources or related decisions.</p>
        </div>
        
        <div class="inquiry-type-item">
          <h3 class="voice-1">Collaboration or referral</h3>
          <p class="voice-2">For people or organizations proposing a relevant collaboration, opportunity or referral.</p>
        </div>
        
        <div class="inquiry-type-item">
          <h3 class="voice-1">Venture Readiness Check-In support</h3>
          <p class="voice-2">For help with a missing result, a broken link or something that may have been processed incorrectly.</p>
        </div>
        
        <div class="inquiry-type-item" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
          <h3 class="voice-1">General inquiry</h3>
          <p class="voice-2">For a relevant question that does not fit the other categories.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION C: INSTITUTIONAL GUIDANCE -->
  <section class="bg-quiet-sand chapter chapter-large-spacing" style="border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Institutional guidance</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">Start with the challenge, not a predetermined service.</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-md);">A useful institutional inquiry explains:</p>
        
        <ul class="editorial-list voice-2" style="margin-bottom: var(--space-lg);">
          <li>the question or decision your organization is working through;</li>
          <li>the people or ventures affected;</li>
          <li>the relevant program, resource, opportunity or support environment; and</li>
          <li>what your organization is trying to understand.</li>
        </ul>
        
        <div style="background-color: var(--color-parchment); padding: var(--space-md); border-left: 2px solid var(--color-quiet-rule); margin-bottom: var(--space-md);">
          <p class="voice-2" style="font-size: 1rem; color: var(--color-tidal-ink); margin: 0;">
            You do not need a completed scope of work or proposed solution. A clear description of the situation is enough to begin considering whether Ethnoir may be a useful fit.
          </p>
        </div>
        
        <a href="/for-organizations" class="link-secondary voice-3" style="font-size: 1rem; color: var(--color-tidal-ink);">Learn more about working with organizations &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SECTION D, E, F: THE FORM & PRIVACY -->
  <section class="bg-parchment chapter chapter-large-spacing">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-lg);">
        <div class="sticky" style="top: 120px;">
          <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Form introduction</span>
          <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1; margin-bottom: var(--space-md);">Share your inquiry</h2>
          <p class="voice-2" style="font-size: 1.125rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md);">
            Complete the short form below.
          </p>
          <p class="voice-2" style="font-size: 1rem; color: var(--color-muted-slate);">
            Submitting an inquiry does not create a client relationship or guarantee that Ethnoir will be able to take the work forward.
          </p>
        </div>
      </div>
      
      <div class="col-12 md-col-7 md-col-8-offset">
        <!-- Success Message (Hidden initially) -->
        <div id="form-success-message" style="display: none; background-color: var(--color-porcelain); padding: var(--space-lg); border: 1px solid var(--color-quiet-rule); margin-bottom: var(--space-xl);">
          <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); margin-bottom: var(--space-sm);">Your inquiry has been received.</h2>
          <p class="voice-2" style="font-size: 1.125rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-lg);">
            Thank you for contacting Ethnoir. Your message will be reviewed, and Ethnoir may follow up using the email address you provided if additional information or a conversation would be useful.
          </p>
          <a href="/" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain);">Return to Home</a>
        </div>
        
        <!-- Error Summary (Hidden initially) -->
        <div id="form-error-summary" style="display: none; background-color: #FDF4F4; padding: var(--space-md); border-left: 4px solid #D93838; margin-bottom: var(--space-lg);">
          <h3 class="voice-1" style="font-size: 1.25rem; color: #D93838; margin-bottom: 4px;">There was a problem with your submission</h3>
          <p id="form-error-text" class="voice-2" style="font-size: 1rem; color: var(--color-tidal-ink); margin: 0;">Please review the errors below and try again.</p>
        </div>

        <form id="ethnoir-contact-form" action="/api/contact.php" method="POST" novalidate>
          
          <!-- Name -->
          <div class="form-group">
            <label for="name" class="voice-1 form-label">Name <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Your first and last name.</p>
            <input type="text" id="name" name="name" class="form-control voice-2" required autocomplete="name">
            <div class="form-error voice-3" id="error-name">Please provide your name.</div>
          </div>
          
          <!-- Email -->
          <div class="form-group">
            <label for="email" class="voice-1 form-label">Email address <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Where Ethnoir can contact you about this inquiry.</p>
            <input type="email" id="email" name="email" class="form-control voice-2" required autocomplete="email">
            <div class="form-error voice-3" id="error-email">Please provide a valid email address.</div>
          </div>
          
          <!-- Organization -->
          <div class="form-group">
            <label for="organization" class="voice-1 form-label">Organization <span id="org-req-mark" class="required-mark" style="display:none;">*</span></label>
            <p class="voice-2 form-help">If you are contacting Ethnoir on behalf of an organization.<br>Required for institutional inquiries; optional otherwise.</p>
            <input type="text" id="organization" name="organization" class="form-control voice-2">
            <div class="form-error voice-3" id="error-organization">Please provide your organization name.</div>
          </div>
          
          <!-- Role -->
          <div class="form-group">
            <label for="role" class="voice-1 form-label">Your role <span id="role-req-mark" class="required-mark" style="display:none;">*</span></label>
            <p class="voice-2 form-help">Your role in the organization or in relation to this inquiry.<br>Required for institutional inquiries; optional otherwise.</p>
            <input type="text" id="role" name="role" class="form-control voice-2">
            <div class="form-error voice-3" id="error-role">Please provide your role.</div>
          </div>
          
          <!-- Inquiry Type (Radio Group) -->
          <div class="form-group">
            <fieldset class="form-fieldset">
              <legend class="voice-1 form-label" style="margin-bottom: var(--space-sm);">What are you contacting Ethnoir about? <span class="required-mark">*</span></legend>
              
              <div class="radio-option">
                <input type="radio" id="type-institutional" name="inquiry_type" value="Institutional or venture-development challenge" required>
                <label for="type-institutional" class="voice-2">Institutional or venture-development challenge</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-collaboration" name="inquiry_type" value="Collaboration or referral" required>
                <label for="type-collaboration" class="voice-2">Collaboration or referral</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-checkin" name="inquiry_type" value="Venture Readiness Check-In support" required>
                <label for="type-checkin" class="voice-2">Venture Readiness Check-In support</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-general" name="inquiry_type" value="General inquiry" required>
                <label for="type-general" class="voice-2">General inquiry</label>
              </div>
              
              <div class="form-error voice-3" id="error-type">Please select an inquiry type.</div>
            </fieldset>
          </div>
          
          <!-- CONDITIONAL: Institutional -->
          <div class="form-group conditional-group" id="cond-institutional" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-md); margin-top: var(--space-md);">
            <label for="institutional_details" class="voice-1 form-label">What venture-development or entrepreneurship-support question is your organization working through? <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Briefly describe the relevant program, decision or support environment, who it affects and what your organization is trying to understand.</p>
            <textarea id="institutional_details" name="institutional_details" class="form-control voice-2" rows="4"></textarea>
            <div class="form-error voice-3" id="error-inst-details">Please provide details about the institutional challenge.</div>
          </div>
          
          <!-- CONDITIONAL: Check-In Support -->
          <div class="form-group conditional-group" id="cond-checkin" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-md); margin-top: var(--space-md);">
            <fieldset class="form-fieldset">
              <legend class="voice-1 form-label" style="margin-bottom: var(--space-sm);">What happened when you used the Check-In? <span class="required-mark">*</span></legend>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-1" name="checkin_issue" value="I did not receive my result">
                <label for="checkin-issue-1" class="voice-2">I did not receive my result</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-2" name="checkin_issue" value="A link did not work">
                <label for="checkin-issue-2" class="voice-2">A link did not work</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-3" name="checkin_issue" value="I believe my result may have been processed incorrectly">
                <label for="checkin-issue-3" class="voice-2">I believe my result may have been processed incorrectly</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-4" name="checkin_issue" value="I have a privacy or data question">
                <label for="checkin-issue-4" class="voice-2">I have a privacy or data question</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-5" name="checkin_issue" value="Something else">
                <label for="checkin-issue-5" class="voice-2">Something else</label>
              </div>
              
              <div class="form-error voice-3" id="error-checkin-issue">Please select what happened.</div>
            </fieldset>
            
            <p class="voice-2 form-help" style="margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--color-quiet-rule);">
              Use the email address submitted with the Check-In. Do not paste your full answers or sensitive business information here.
            </p>
          </div>
          
          <!-- General Description -->
          <div class="form-group" style="margin-top: var(--space-lg);">
            <label for="description" class="voice-1 form-label">Briefly describe your inquiry. <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Share the question, situation or proposed connection. Please do not include sensitive or confidential information.</p>
            <textarea id="description" name="description" class="form-control voice-2" rows="5" required></textarea>
            <div class="form-error voice-3" id="error-description">Please provide a description of your inquiry.</div>
          </div>
          
          <!-- Privacy Section -->
          <div style="background-color: var(--color-porcelain); padding: var(--space-lg); border: 1px solid var(--color-strong-boundary); margin: var(--space-xl) 0;">
            <h2 class="voice-1" style="font-size: 1.5rem; color: var(--color-tidal-ink); margin-bottom: var(--space-sm);">Share only what is needed for an initial inquiry.</h2>
            <p class="voice-2" style="font-size: 1rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md);">
              Please do not submit financial statements, bank or payment information, passwords, government identification numbers, health information, detailed participant records, confidential business documents or other sensitive personal information through this form.
            </p>
            <p class="voice-2" style="font-size: 1rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md);">
              If additional information would be useful, Ethnoir can discuss an appropriate way to provide it later.
            </p>
            <a href="/privacy" class="link-secondary voice-3" style="font-size: 0.875rem; margin-bottom: var(--space-lg); display: inline-block;">Read the Ethnoir Privacy Notice &rarr;</a>
            
            <div class="checkbox-option" style="padding-top: var(--space-md); border-top: 1px solid var(--color-quiet-rule);">
              <input type="checkbox" id="privacy_ack" name="privacy_ack" required>
              <label for="privacy_ack" class="voice-2" style="font-size: 0.9375rem;">
                I have read the Ethnoir Privacy Notice and understand that the information I submit will be used to review and respond to this inquiry. <span class="required-mark">*</span>
              </label>
            </div>
            <div class="form-error voice-3" id="error-privacy" style="margin-left: 28px;">You must acknowledge the privacy notice to submit.</div>
          </div>
          
          <!-- Submit -->
          <div class="form-actions" style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <button type="submit" id="submit-btn" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain); border: none; cursor: pointer; text-align: left; align-self: flex-start;">
              Send inquiry
            </button>
            <p class="voice-3" id="submit-status" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0; min-height: 1.5em;"></p>
          </div>
          
          <!-- Honeypot -->
          <div style="display: none;" aria-hidden="true">
            <label for="website_url">Website URL (leave blank)</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1">
          </div>
          
        </form>
      </div>
    </div>
  </section>

  <!-- SECTION F: AFTER SUBMISSION -->
  <section class="bg-porcelain chapter chapter-large-spacing" style="border-top: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">After submission</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">What happens next?</h2>
      </div>
      
      <div class="col-12 md-col-7 md-col-8-offset">
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-md); color: var(--color-tidal-ink);">
          Ethnoir will review the information you provide.
        </p>
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-md); color: var(--color-deep-body-ink);">
          If the inquiry appears relevant and further discussion may be useful, Ethnoir may contact you to clarify the question or discuss a possible next step.
        </p>
        <p class="voice-2" style="font-size: 1.125rem; margin: 0; color: var(--color-muted-slate);">
          Some inquiries may be outside Ethnoir’s current scope or capacity. Submission does not guarantee a response, meeting or engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION G: ALTERNATIVE SUPPORT ROUTE -->
  <section class="bg-quiet-sand chapter" style="padding-top: var(--space-xl); padding-bottom: var(--space-xl); border-top: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-sm);">
        <h2 class="voice-1" style="font-size: 1.5rem; color: var(--color-tidal-ink); line-height: 1.1;">Unable to use the form?</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-sm); color: var(--color-tidal-ink);">
          Contact Ethnoir at <a href="mailto:support@ethnoir.com" style="color: var(--color-deep-teal);">support@ethnoir.com</a>.
        </p>
        <p class="voice-2" style="font-size: 1rem; margin: 0; color: var(--color-deep-body-ink);">
          For Check-In support, include the email address you used for the Check-In and briefly describe what went wrong. Do not email passwords, financial records or other sensitive information.
        </p>
      </div>
    </div>
  </section>

</Layout>

<style>
  .col-12 { grid-column: span 12; }
  
  .inquiry-type-item {
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-quiet-rule);
    padding-bottom: var(--space-md);
  }
  .inquiry-type-item h3 {
    font-size: 1.25rem;
    color: var(--color-tidal-ink);
    margin-bottom: 4px;
  }
  .inquiry-type-item p {
    font-size: 1.125rem;
    color: var(--color-deep-body-ink);
    margin: 0;
  }
  
  .editorial-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-quiet-rule);
  }
  .editorial-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-quiet-rule);
    font-size: 1.125rem;
    color: var(--color-tidal-ink);
  }

  /* Form Styles */
  .form-group {
    margin-bottom: var(--space-lg);
  }
  
  .form-label {
    display: block;
    font-size: 1.125rem;
    color: var(--color-tidal-ink);
    margin-bottom: 4px;
  }
  
  .form-help {
    font-size: 0.9375rem;
    color: var(--color-muted-slate);
    margin-bottom: 8px;
    margin-top: 0;
  }
  
  .required-mark {
    color: #D93838;
  }
  
  .form-control {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--color-porcelain);
    border: 1px solid var(--color-strong-boundary);
    font-size: 1rem;
    color: var(--color-tidal-ink);
    border-radius: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  
  .form-control:focus {
    outline: none;
    border-color: var(--color-deep-teal);
    box-shadow: 0 0 0 2px rgba(13, 98, 100, 0.2);
  }
  
  .form-control.is-invalid {
    border-color: #D93838;
    background-color: #FDF4F4;
  }
  
  .form-error {
    display: none;
    color: #D93838;
    font-size: 0.875rem;
    margin-top: 6px;
  }
  
  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }
  
  .radio-option, .checkbox-option {
    display: flex;
    align-items: flex-start;
    margin-bottom: 12px;
  }
  
  .radio-option input[type="radio"], .checkbox-option input[type="checkbox"] {
    margin-top: 4px;
    margin-right: 12px;
    width: 16px;
    height: 16px;
    accent-color: var(--color-deep-teal);
  }
  
  .radio-option label, .checkbox-option label {
    font-size: 1rem;
    color: var(--color-tidal-ink);
    line-height: 1.4;
    cursor: pointer;
  }
  
  @media (min-width: 768px) {
    .md-col-9 { grid-column: span 9; }
    .md-col-8 { grid-column: span 8; }
    .md-col-7 { grid-column: span 7; }
    .md-col-4 { grid-column: span 4; }
    .md-col-8-offset { grid-column: 6 / span 7; }
  }
  
  @media (max-width: 767px) {
    .sticky { position: static !important; }
  }
</style>

<script>
  // Form Interaction Logic
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ethnoir-contact-form') as HTMLFormElement;
    const typeRadios = document.querySelectorAll('input[name="inquiry_type"]');
    
    // Conditional wrappers
    const condInstitutional = document.getElementById('cond-institutional');
    const condCheckin = document.getElementById('cond-checkin');
    
    // Conditional fields
    const orgInput = document.getElementById('organization') as HTMLInputElement;
    const roleInput = document.getElementById('role') as HTMLInputElement;
    const instDetailsInput = document.getElementById('institutional_details') as HTMLTextAreaElement;
    const checkinRadios = document.querySelectorAll('input[name="checkin_issue"]');
    
    // Required markers
    const orgReqMark = document.getElementById('org-req-mark');
    const roleReqMark = document.getElementById('role-req-mark');
    
    // Submit state
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitStatus = document.getElementById('submit-status');
    const successMessage = document.getElementById('form-success-message');
    const errorSummary = document.getElementById('form-error-summary');
    const errorText = document.getElementById('form-error-text');
    
    // Handle inquiry type changes
    typeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        
        // Reset required states first
        orgInput.required = false;
        roleInput.required = false;
        if (orgReqMark) orgReqMark.style.display = 'none';
        if (roleReqMark) roleReqMark.style.display = 'none';
        
        instDetailsInput.required = false;
        if (condInstitutional) condInstitutional.style.display = 'none';
        
        checkinRadios.forEach((r: any) => r.required = false);
        if (condCheckin) condCheckin.style.display = 'none';
        
        // Apply conditional logic
        if (val === 'Institutional or venture-development challenge') {
          orgInput.required = true;
          roleInput.required = true;
          if (orgReqMark) orgReqMark.style.display = 'inline';
          if (roleReqMark) roleReqMark.style.display = 'inline';
          
          instDetailsInput.required = true;
          if (condInstitutional) condInstitutional.style.display = 'block';
        } 
        else if (val === 'Venture Readiness Check-In support') {
          checkinRadios.forEach((r: any) => r.required = true);
          if (condCheckin) condCheckin.style.display = 'block';
        }
      });
    });
    
    // Basic validation function
    const validateField = (field: HTMLInputElement | HTMLTextAreaElement, errorId: string) => {
      const errorEl = document.getElementById(errorId);
      if (!field.validity.valid) {
        field.classList.add('is-invalid');
        if (errorEl) errorEl.style.display = 'block';
        return false;
      } else {
        field.classList.remove('is-invalid');
        if (errorEl) errorEl.style.display = 'none';
        return true;
      }
    };
    
    const validateRadioGroup = (radios: NodeListOf<Element>, errorId: string) => {
      let isRequired = false;
      let isChecked = false;
      radios.forEach((r: any) => {
        if (r.required) isRequired = true;
        if (r.checked) isChecked = true;
      });
      
      const errorEl = document.getElementById(errorId);
      if (isRequired && !isChecked) {
        if (errorEl) errorEl.style.display = 'block';
        return false;
      } else {
        if (errorEl) errorEl.style.display = 'none';
        return true;
      }
    };
    
    // Form submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset summaries
        if (errorSummary) errorSummary.style.display = 'none';
        
        // Validate
        let isValid = true;
        isValid = validateField(document.getElementById('name') as HTMLInputElement, 'error-name') && isValid;
        isValid = validateField(document.getElementById('email') as HTMLInputElement, 'error-email') && isValid;
        
        if (orgInput.required) isValid = validateField(orgInput, 'error-organization') && isValid;
        if (roleInput.required) isValid = validateField(roleInput, 'error-role') && isValid;
        
        isValid = validateRadioGroup(typeRadios, 'error-type') && isValid;
        
        if (instDetailsInput.required) isValid = validateField(instDetailsInput, 'error-inst-details') && isValid;
        if (condCheckin && condCheckin.style.display === 'block') isValid = validateRadioGroup(checkinRadios, 'error-checkin-issue') && isValid;
        
        isValid = validateField(document.getElementById('description') as HTMLTextAreaElement, 'error-description') && isValid;
        
        const privacyAck = document.getElementById('privacy_ack') as HTMLInputElement;
        const privError = document.getElementById('error-privacy');
        if (!privacyAck.checked) {
          if (privError) privError.style.display = 'block';
          isValid = false;
        } else {
          if (privError) privError.style.display = 'none';
        }
        
        if (!isValid) {
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "Please review the highlighted fields below and try again.";
          // Scroll to error summary
          errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        
        // Set loading state
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        if (submitStatus) submitStatus.textContent = '';
        
        // Submit via AJAX
        try {
          const formData = new FormData(form);
          
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            // Success!
            form.style.display = 'none';
            if (successMessage) {
              successMessage.style.display = 'block';
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          } else {
            // Server reported an error
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send inquiry';
            if (errorSummary) errorSummary.style.display = 'block';
            if (errorText) errorText.textContent = result.message || "An error occurred on the server. Please try again later.";
          }
        } catch (err) {
          // Network error
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send inquiry';
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "A network error occurred. Please check your connection and try again.";
        }
      });
    }
  });
</script>
