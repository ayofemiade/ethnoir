---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Ethnoir"
  description="Contact Ethnoir about an entrepreneurship-support question, a collaboration, or help with the Venture Readiness Check-In."
>
  <!-- SECTION A: OPENING -->
  <section class="bg-parchment" style="padding: var(--space-lg) 0 var(--space-xl) 0; border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12" style="margin-bottom: var(--space-sm);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em;">Contact</span>
      </div>
      
      <div class="col-12 md-col-9" style="margin-bottom: var(--space-lg);">
        <h1 class="voice-1" style="font-size: clamp(2.5rem, 6vw, 4.5rem); margin: 0; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-tidal-ink);">
          Contact Ethnoir
        </h1>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.25rem; line-height: 1.5; color: var(--color-deep-teal); margin-bottom: var(--space-sm);">
          Use this page to bring a question about supporting entrepreneurs, propose a collaboration, ask for help with the Venture Readiness Check-In, or send a general inquiry.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION B: INQUIRY TYPES -->
  <section class="bg-porcelain chapter chapter-large-spacing" style="border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Inquiry types</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">What would you like to contact Ethnoir about?</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <div class="inquiry-type-item">
          <h3 class="voice-1">Organization inquiry: a program or support challenge</h3>
          <p class="voice-2">For organizations with a question about entrepreneurs, support programs, resources or related decisions.</p>
        </div>
        
        <div class="inquiry-type-item">
          <h3 class="voice-1">Collaboration or referral</h3>
          <p class="voice-2">For people or organizations proposing a relevant collaboration, opportunity or referral.</p>
        </div>
        
        <div class="inquiry-type-item">
          <h3 class="voice-1">Venture Readiness Check-In support</h3>
          <p class="voice-2">For a missing result, a broken link or something that may have been processed incorrectly.</p>
        </div>
        
        <div class="inquiry-type-item" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
          <h3 class="voice-1">General inquiry</h3>
          <p class="voice-2">For a relevant question that fits none of the above.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION C: STARTING AN ORGANIZATION INQUIRY GUIDANCE -->
  <section class="bg-quiet-sand chapter chapter-large-spacing" style="border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Starting an organization inquiry</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">Start with the challenge, not a predetermined service.</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.125rem; line-height: 1.6; margin-bottom: var(--space-md);">
          Describe the support you offer, who it is intended for and what is proving difficult. This could concern participant needs, access, application, delivery processes or evidence. Tell us the decision you need to make and any relevant timing. You do not need a finished scope of work.
        </p>
        
        <a href="/for-organizations" class="link-secondary voice-3" style="font-size: 1rem; color: var(--color-tidal-ink);">Learn more about working with organizations &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SECTION D, E: THE FORM -->
  <section class="bg-parchment chapter chapter-large-spacing">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-lg);">
        <div class="sticky" style="top: 120px;">
          <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Form introduction</span>
          <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1; margin-bottom: var(--space-md);">Share your inquiry</h2>
          <p class="voice-2" style="font-size: 1.125rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md); line-height: 1.5;">
            Complete the short form below.
          </p>
          <p class="voice-2" style="font-size: 1rem; color: var(--color-muted-slate); line-height: 1.5;">
            Submitting an inquiry does not create a client relationship or guarantee that Ethnoir will be able to take the work forward.
          </p>
        </div>
      </div>
      
      <div class="col-12 md-col-7 md-col-8-offset">
        <!-- Success Message (Hidden initially) -->
        <div id="form-success-message" style="display: none; background-color: var(--color-porcelain); padding: var(--space-lg); border: 1px solid var(--color-quiet-rule); margin-bottom: var(--space-xl);">
          <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); margin-bottom: var(--space-sm);">Your inquiry has been received.</h2>
          <p class="voice-2" style="font-size: 1.125rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-lg); line-height: 1.6;">
            Thank you for contacting Ethnoir. Your message will be reviewed, and Ethnoir may follow up using the email address you provided if additional information or a conversation would be useful.
          </p>
          <a href="/" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain); text-decoration: none; display: inline-block;">Return to Home</a>
        </div>
        
        <!-- Error Summary (Hidden initially) -->
        <div id="form-error-summary" style="display: none; background-color: #FDF4F4; padding: var(--space-md); border-left: 4px solid #D93838; margin-bottom: var(--space-lg);">
          <h3 class="voice-1" style="font-size: 1.25rem; color: #D93838; margin-bottom: 4px;">There was a problem with your submission</h3>
          <p id="form-error-text" class="voice-2" style="font-size: 1rem; color: var(--color-tidal-ink); margin: 0;">Please review the errors below and try again.</p>
        </div>

        <form id="ethnoir-contact-form" action="/api/contact.php" method="POST" novalidate>
          
          <!-- Name -->
          <div class="form-group">
            <label for="name" class="voice-1 form-label">Name <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Your first and last name.</p>
            <input type="text" id="name" name="name" class="form-control voice-2" required autocomplete="name">
            <div class="form-error voice-3" id="error-name">Please provide your first and last name.</div>
          </div>
          
          <!-- Email address -->
          <div class="form-group">
            <label for="email" class="voice-1 form-label">Email address <span class="required-mark">*</span></label>
            <p class="voice-2 form-help">Where Ethnoir can contact you about this inquiry.</p>
            <input type="email" id="email" name="email" class="form-control voice-2" required autocomplete="email">
            <div class="form-error voice-3" id="error-email">Please provide a valid email address.</div>
          </div>

          <!-- Inquiry Type (Radio Group) -->
          <div class="form-group">
            <fieldset class="form-fieldset">
              <legend class="voice-1 form-label" style="margin-bottom: var(--space-sm);">What would you like to contact Ethnoir about? <span class="required-mark">*</span></legend>
              
              <div class="radio-option">
                <input type="radio" id="type-organization" name="inquiry_type" value="Organization inquiry: a program or support challenge" required>
                <div>
                  <label for="type-organization" class="voice-2" style="font-weight: 600;">Organization inquiry: a program or support challenge</label>
                  <p class="voice-2 form-help" style="margin: 2px 0 0 0;">For organizations with a question about entrepreneurs, support programs, resources or related decisions.</p>
                </div>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-collaboration" name="inquiry_type" value="Collaboration or referral" required>
                <div>
                  <label for="type-collaboration" class="voice-2" style="font-weight: 600;">Collaboration or referral</label>
                  <p class="voice-2 form-help" style="margin: 2px 0 0 0;">For people or organizations proposing a relevant collaboration, opportunity or referral.</p>
                </div>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-checkin" name="inquiry_type" value="Venture Readiness Check-In support" required>
                <div>
                  <label for="type-checkin" class="voice-2" style="font-weight: 600;">Venture Readiness Check-In support</label>
                  <p class="voice-2 form-help" style="margin: 2px 0 0 0;">For a missing result, a broken link or something that may have been processed incorrectly.</p>
                </div>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="type-general" name="inquiry_type" value="General inquiry" required>
                <div>
                  <label for="type-general" class="voice-2" style="font-weight: 600;">General inquiry</label>
                  <p class="voice-2 form-help" style="margin: 2px 0 0 0;">For a relevant question that fits none of the above.</p>
                </div>
              </div>
              
              <div class="form-error voice-3" id="error-type">Please select an inquiry type.</div>
            </fieldset>
          </div>
          
          <!-- CONDITIONAL: Organization Fields (Shown/Required for Organization inquiry) -->
          <div id="cond-organization" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-md); margin-bottom: var(--space-lg); border-left: 2px solid var(--color-deep-teal);">
            <!-- Organization -->
            <div class="form-group" style="margin-bottom: var(--space-md);">
              <label for="organization" class="voice-1 form-label">Organization <span id="org-req-mark" class="required-mark">*</span></label>
              <p class="voice-2 form-help">If you are contacting Ethnoir on behalf of an organization.</p>
              <input type="text" id="organization" name="organization" class="form-control voice-2">
              <div class="form-error voice-3" id="error-organization">Please provide your organization name.</div>
            </div>
            
            <!-- Role -->
            <div class="form-group" style="margin-bottom: 0;">
              <label for="role" class="voice-1 form-label">Your role <span id="role-req-mark" class="required-mark">*</span></label>
              <p class="voice-2 form-help">Your role in the organization or in relation to this inquiry.</p>
              <input type="text" id="role" name="role" class="form-control voice-2">
              <div class="form-error voice-3" id="error-role">Please provide your role.</div>
            </div>
          </div>
          
          <!-- CONDITIONAL: Check-In Support Field (Shown/Required for Check-In support) -->
          <div class="form-group conditional-group" id="cond-checkin" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-md); margin-bottom: var(--space-lg); border-left: 2px solid var(--color-deep-teal);">
            <fieldset class="form-fieldset">
              <legend class="voice-1 form-label" style="margin-bottom: var(--space-sm);">What happened when you used the Check-In? <span class="required-mark">*</span></legend>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-1" name="checkin_issue" value="I did not receive my result">
                <label for="checkin-issue-1" class="voice-2">I did not receive my result</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-2" name="checkin_issue" value="A link did not work">
                <label for="checkin-issue-2" class="voice-2">A link did not work</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-3" name="checkin_issue" value="I believe my result may have been processed incorrectly">
                <label for="checkin-issue-3" class="voice-2">I believe my result may have been processed incorrectly</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-4" name="checkin_issue" value="I have a privacy or data question">
                <label for="checkin-issue-4" class="voice-2">I have a privacy or data question</label>
              </div>
              
              <div class="radio-option">
                <input type="radio" id="checkin-issue-5" name="checkin_issue" value="Something else">
                <label for="checkin-issue-5" class="voice-2">Something else</label>
              </div>
              
              <div class="form-error voice-3" id="error-checkin-issue">Please select what happened.</div>
            </fieldset>
            
            <p class="voice-2 form-help" style="margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--color-quiet-rule);">
              Use the email address submitted with the Check-In. Do not paste your full answers or sensitive business information here.
            </p>
          </div>
          
          <!-- Briefly describe your inquiry -->
          <div class="form-group" style="margin-top: var(--space-md);">
            <label for="description" class="voice-1 form-label">Briefly describe your inquiry <span class="required-mark">*</span></label>
            <p class="voice-2 form-help" id="description-help" style="line-height: 1.5;">
              For Organization inquiry: describe the support you offer, who it serves, what is proving difficult and the decision you need to make. For other inquiry types: briefly describe your question, situation or proposed connection. Do not include sensitive or confidential information.
            </p>
            <textarea id="description" name="description" class="form-control voice-2" rows="5" required></textarea>
            <div class="form-error voice-3" id="error-description">Please describe your inquiry.</div>
          </div>
          
          <!-- Privacy Section -->
          <div style="background-color: var(--color-porcelain); padding: var(--space-lg); border: 1px solid var(--color-strong-boundary); margin: var(--space-xl) 0;">
            <h2 class="voice-1" style="font-size: 1.5rem; color: var(--color-tidal-ink); margin-bottom: var(--space-sm);">Share only what is needed for an initial inquiry.</h2>
            <p class="voice-2" style="font-size: 1rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md); line-height: 1.6;">
              Please do not submit financial statements, bank or payment information, passwords, government identification numbers, health information, detailed participant records, confidential business documents or other sensitive personal information through this form.
            </p>
            <p class="voice-2" style="font-size: 1rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-md); line-height: 1.6;">
              If additional information would be useful, Ethnoir can discuss an appropriate way to provide it later.
            </p>
            <div style="padding-top: var(--space-md); border-top: 1px solid var(--color-quiet-rule);">
              <p class="voice-2" style="font-size: 0.9375rem; color: var(--color-deep-body-ink); margin: 0; line-height: 1.5;">
                Ethnoir uses your information to review and respond to this inquiry. Read the <a href="/privacy" style="color: var(--color-deep-teal); text-decoration: underline;">Privacy Notice</a>. No marketing subscription is created by this form.
              </p>
            </div>
          </div>
          
          <!-- Submit -->
          <div class="form-actions" style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <button type="submit" id="submit-btn" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain); border: none; cursor: pointer; text-align: left; align-self: flex-start;">
              Send inquiry
            </button>
            <p class="voice-3" id="submit-status" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0; min-height: 1.5em;"></p>
          </div>
          
          <!-- Hidden Honeypot Spam-Trap Field (must stay invisible) -->
          <div style="display: none;" aria-hidden="true">
            <label for="website_url">Website URL (leave blank)</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
          </div>
          
        </form>
      </div>
    </div>
  </section>

  <!-- SECTION F: AFTER SUBMISSION -->
  <section class="bg-porcelain chapter chapter-large-spacing" style="border-top: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-md);">
        <span class="voice-3" style="color: var(--color-muted-slate); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">After submission</span>
        <h2 class="voice-1" style="font-size: 2rem; color: var(--color-tidal-ink); line-height: 1.1;">What happens next?</h2>
      </div>
      
      <div class="col-12 md-col-7 md-col-8-offset">
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-md); color: var(--color-deep-body-ink); line-height: 1.6;">
          Ethnoir will review what you send. If the inquiry appears relevant, Ethnoir may contact you to clarify the question or discuss a possible next step.
        </p>
        <p class="voice-2" style="font-size: 1.125rem; margin: 0; color: var(--color-muted-slate); line-height: 1.6;">
          Some inquiries may be outside Ethnoir’s current scope or capacity. Sending an inquiry does not create a client relationship or guarantee a response, meeting or engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION G: FALLBACK LINE -->
  <section class="bg-quiet-sand chapter" style="padding-top: var(--space-xl); padding-bottom: var(--space-xl); border-top: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4" style="margin-bottom: var(--space-sm);">
        <h2 class="voice-1" style="font-size: 1.5rem; color: var(--color-tidal-ink); line-height: 1.1;">Unable to use the form?</h2>
      </div>
      
      <div class="col-12 md-col-8">
        <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-sm); color: var(--color-tidal-ink); line-height: 1.6;">
          Contact Ethnoir at <a href="mailto:omichael@ethnoirconsulting.com" style="color: var(--color-deep-teal); text-decoration: underline;">omichael@ethnoirconsulting.com</a>.
        </p>
        <p class="voice-2" style="font-size: 1rem; margin: 0; color: var(--color-deep-body-ink); line-height: 1.6;">
          For Check-In support, include the email address you used for the Check-In and briefly describe what went wrong.
        </p>
      </div>
    </div>
  </section>

</Layout>

<style>
  .col-12 { grid-column: span 12; }
  
  .inquiry-type-item {
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-quiet-rule);
    padding-bottom: var(--space-md);
  }
  .inquiry-type-item h3 {
    font-size: 1.25rem;
    color: var(--color-tidal-ink);
    margin-bottom: 4px;
  }
  .inquiry-type-item p {
    font-size: 1.125rem;
    color: var(--color-deep-body-ink);
    margin: 0;
    line-height: 1.5;
  }
  
  .editorial-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-quiet-rule);
  }
  .editorial-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-quiet-rule);
    font-size: 1.125rem;
    color: var(--color-tidal-ink);
    line-height: 1.5;
  }

  /* Form Styles */
  .form-group {
    margin-bottom: var(--space-lg);
  }
  
  .form-label {
    display: block;
    font-size: 1.125rem;
    color: var(--color-tidal-ink);
    margin-bottom: 4px;
  }
  
  .form-help {
    font-size: 0.9375rem;
    color: var(--color-muted-slate);
    margin-bottom: 8px;
    margin-top: 0;
  }
  
  .required-mark {
    color: #D93838;
  }
  
  .form-control {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--color-porcelain);
    border: 1px solid var(--color-strong-boundary);
    font-size: 1rem;
    color: var(--color-tidal-ink);
    border-radius: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  
  .form-control:focus {
    outline: none;
    border-color: var(--color-deep-teal);
    box-shadow: 0 0 0 2px rgba(13, 98, 100, 0.2);
  }
  
  .form-control.is-invalid {
    border-color: #D93838;
    background-color: #FDF4F4;
  }
  
  .form-error {
    display: none;
    color: #D93838;
    font-size: 0.875rem;
    margin-top: 6px;
  }
  
  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }
  
  .radio-option {
    display: flex;
    align-items: flex-start;
    margin-bottom: 16px;
  }
  
  .radio-option input[type="radio"] {
    margin-top: 4px;
    margin-right: 12px;
    width: 18px;
    height: 18px;
    accent-color: var(--color-deep-teal);
    flex-shrink: 0;
  }
  
  .radio-option label {
    font-size: 1rem;
    color: var(--color-tidal-ink);
    line-height: 1.4;
    cursor: pointer;
  }
  
  @media (min-width: 768px) {
    .md-col-9 { grid-column: span 9; }
    .md-col-8 { grid-column: span 8; }
    .md-col-7 { grid-column: span 7; }
    .md-col-4 { grid-column: span 4; }
    .md-col-8-offset { grid-column: 6 / span 7; }
  }
  
  @media (max-width: 767px) {
    .sticky { position: static !important; }
  }
</style>

<script>
  // Form Interaction Logic
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ethnoir-contact-form') as HTMLFormElement;
    const typeRadios = document.querySelectorAll('input[name="inquiry_type"]');
    
    // Conditional containers
    const condOrganization = document.getElementById('cond-organization');
    const condCheckin = document.getElementById('cond-checkin');
    
    // Conditional inputs
    const orgInput = document.getElementById('organization') as HTMLInputElement;
    const roleInput = document.getElementById('role') as HTMLInputElement;
    const checkinRadios = document.querySelectorAll('input[name="checkin_issue"]');
    const descriptionHelp = document.getElementById('description-help');
    
    // Submit state elements
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitStatus = document.getElementById('submit-status');
    const successMessage = document.getElementById('form-success-message');
    const errorSummary = document.getElementById('form-error-summary');
    const errorText = document.getElementById('form-error-text');
    
    const defaultHelpText = "For Organization inquiry: describe the program or support challenge, who it affects, and the decision your organization is working through. For other inquiry types: briefly describe your question, situation or proposed connection. Do not include sensitive or confidential information.";
    const orgHelpText = "Describe the program or support challenge, who it affects, and the decision your organization is working through. Do not include sensitive or confidential information.";
    const generalHelpText = "Briefly describe your question, situation or proposed connection. Do not include sensitive or confidential information.";

    // Handle inquiry type selection
    typeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        
        // Reset conditional states
        if (orgInput) {
          orgInput.required = false;
          orgInput.classList.remove('is-invalid');
        }
        if (roleInput) {
          roleInput.required = false;
          roleInput.classList.remove('is-invalid');
        }
        if (condOrganization) condOrganization.style.display = 'none';
        
        checkinRadios.forEach((r: any) => {
          r.required = false;
        });
        if (condCheckin) condCheckin.style.display = 'none';
        
        // Apply conditional display & requirements based on selected inquiry type
        if (val.includes('Organization inquiry') || val.includes('Institutional')) {
          if (condOrganization) condOrganization.style.display = 'block';
          if (orgInput) orgInput.required = true;
          if (roleInput) roleInput.required = true;
          if (descriptionHelp) descriptionHelp.textContent = orgHelpText;
        } else if (val.includes('Check-In support')) {
          if (condCheckin) condCheckin.style.display = 'block';
          checkinRadios.forEach((r: any) => { r.required = true; });
          if (descriptionHelp) descriptionHelp.textContent = generalHelpText;
        } else {
          if (descriptionHelp) descriptionHelp.textContent = generalHelpText;
        }
      });
    });

    // Handle URL query parameter pre-selection (e.g. /contact?type=institutional or /contact?type=organization or /contact?type=checkin-support)
    const urlParams = new URLSearchParams(window.location.search);
    const typeParam = urlParams.get('type');
    if (typeParam) {
      const lower = typeParam.toLowerCase();
      if (lower.includes('org') || lower.includes('inst')) {
        const orgRadio = document.getElementById('type-organization') as HTMLInputElement;
        if (orgRadio) {
          orgRadio.checked = true;
          orgRadio.dispatchEvent(new Event('change'));
        }
      } else if (lower.includes('checkin') || lower.includes('check-in') || lower.includes('support')) {
        const checkinRadio = document.getElementById('type-checkin') as HTMLInputElement;
        if (checkinRadio) {
          checkinRadio.checked = true;
          checkinRadio.dispatchEvent(new Event('change'));
        }
      } else if (lower.includes('collab')) {
        const collabRadio = document.getElementById('type-collaboration') as HTMLInputElement;
        if (collabRadio) {
          collabRadio.checked = true;
          collabRadio.dispatchEvent(new Event('change'));
        }
      } else if (lower.includes('gen')) {
        const genRadio = document.getElementById('type-general') as HTMLInputElement;
        if (genRadio) {
          genRadio.checked = true;
          genRadio.dispatchEvent(new Event('change'));
        }
      }
    }
    
    // Field validation helper
    const validateField = (field: HTMLInputElement | HTMLTextAreaElement, errorId: string) => {
      const errorEl = document.getElementById(errorId);
      if (!field.validity.valid || (field.required && !field.value.trim())) {
        field.classList.add('is-invalid');
        if (errorEl) errorEl.style.display = 'block';
        return false;
      } else {
        field.classList.remove('is-invalid');
        if (errorEl) errorEl.style.display = 'none';
        return true;
      }
    };
    
    const validateRadioGroup = (radios: NodeListOf<Element>, errorId: string) => {
      let isRequired = false;
      let isChecked = false;
      radios.forEach((r: any) => {
        if (r.required) isRequired = true;
        if (r.checked) isChecked = true;
      });
      
      const errorEl = document.getElementById(errorId);
      if (isRequired && !isChecked) {
        if (errorEl) errorEl.style.display = 'block';
        return false;
      } else {
        if (errorEl) errorEl.style.display = 'none';
        return true;
      }
    };
    
    // Form submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset summary
        if (errorSummary) errorSummary.style.display = 'none';
        
        // Validate all active fields
        let isValid = true;
        isValid = validateField(document.getElementById('name') as HTMLInputElement, 'error-name') && isValid;
        isValid = validateField(document.getElementById('email') as HTMLInputElement, 'error-email') && isValid;
        isValid = validateRadioGroup(typeRadios, 'error-type') && isValid;
        
        if (orgInput && orgInput.required) {
          isValid = validateField(orgInput, 'error-organization') && isValid;
        }
        if (roleInput && roleInput.required) {
          isValid = validateField(roleInput, 'error-role') && isValid;
        }
        
        if (condCheckin && condCheckin.style.display === 'block') {
          isValid = validateRadioGroup(checkinRadios, 'error-checkin-issue') && isValid;
        }
        
        isValid = validateField(document.getElementById('description') as HTMLTextAreaElement, 'error-description') && isValid;
        
        if (!isValid) {
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "Please review the errors below and try again.";
          errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        
        // Set loading state
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        if (submitStatus) submitStatus.textContent = '';
        
        // Submit via AJAX
        try {
          const formData = new FormData(form);
          
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            // Success state
            form.style.display = 'none';
            if (successMessage) {
              successMessage.style.display = 'block';
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          } else {
            // Server error state
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send inquiry';
            if (errorSummary) errorSummary.style.display = 'block';
            if (errorText) errorText.textContent = result.message || "There was a problem with your submission. Please review the errors below and try again.";
            errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } catch (err) {
          // Network error state
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send inquiry';
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "There was a problem with your submission. Please review the errors below and try again.";
          errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }
  });
</script>
