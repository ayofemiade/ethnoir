---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Ethnoir"
  description="Tell us what you’d like to discuss—an organizational challenge, a collaboration, a workshop or speaking engagement, or a question about the Venture Readiness Check-In."
>
  <!-- SECTION A: OPENING MASTHEAD -->
  <section class="bg-parchment" style="padding: var(--space-2xl) 0 var(--space-xl) 0; border-bottom: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 lg-col-10" style="margin-bottom: var(--space-md);">
        <h1 class="voice-1" style="font-size: clamp(2.75rem, 6.5vw, 5rem); margin: 0; line-height: 1.05; letter-spacing: -0.025em; color: var(--color-tidal-ink);">
          Contact Ethnoir
        </h1>
      </div>
      
      <!-- Body directly below heading without separating divider -->
      <div class="col-12 lg-col-9">
        <p class="voice-2" style="font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.55; color: var(--color-deep-teal); margin: 0 0 var(--space-md) 0;">
          Tell us what you’d like to discuss—an organizational challenge, a collaboration, a workshop or speaking engagement, or a question about the Venture Readiness Check-In.
        </p>
        <p class="voice-2" style="font-size: 1.0625rem; line-height: 1.6; color: var(--color-tidal-ink); margin: 0;">
          For organizational inquiries, briefly describe who your support serves, what needs attention and any relevant timing. You do not need a finished project brief.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION B: FORM & BOOKING PANEL -->
  <section class="bg-porcelain chapter chapter-large-spacing">
    <div class="container grid-12">
      
      <!-- Left Column: Inquiry Form -->
      <div class="col-12 lg-col-7" style="margin-bottom: var(--space-2xl);">
        <div>
          <h2 class="voice-1" style="font-size: clamp(1.85rem, 3.5vw, 2.5rem); color: var(--color-tidal-ink); line-height: 1.15; margin: 0 0 6px 0;">
            Send your inquiry
          </h2>
          <p class="voice-3" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0 0 var(--space-xl) 0;">
            Fields marked * are required.
          </p>

          <!-- Success Message (Hidden initially) -->
          <div id="form-success-message" style="display: none; background-color: var(--color-parchment); padding: var(--space-xl); border: 1px solid var(--color-quiet-rule); border-top: 3px solid var(--color-deep-teal); margin-bottom: var(--space-xl); border-radius: 2px;">
            <h3 class="voice-1" style="font-size: 1.75rem; color: var(--color-tidal-ink); margin: 0 0 var(--space-sm) 0;">
              Your inquiry has been received.
            </h3>
            <p class="voice-2" style="font-size: 1.0625rem; color: var(--color-deep-body-ink); margin-bottom: var(--space-lg); line-height: 1.6;">
              Thank you for contacting Ethnoir. Your message will be reviewed, and Ethnoir may follow up using the email address you provided if additional information or a conversation would be useful.
            </p>
            <a href="/" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain); text-decoration: none; display: inline-block; padding: var(--space-xs) var(--space-md); border-radius: 2px;">
              Return to Home
            </a>
          </div>
          
          <!-- Error Summary (Hidden initially) -->
          <div id="form-error-summary" style="display: none; background-color: #FDF4F4; padding: var(--space-md); border: 1px solid #E8B4B4; border-left: 4px solid #D93838; margin-bottom: var(--space-lg); border-radius: 2px;">
            <h4 class="voice-1" style="font-size: 1.15rem; color: #D93838; margin: 0 0 4px 0;">
              There was a problem with your submission
            </h4>
            <p id="form-error-text" class="voice-2" style="font-size: 0.9375rem; color: var(--color-tidal-ink); margin: 0;">
              Please review the errors below and try again.
            </p>
          </div>

          <form id="ethnoir-contact-form" action="/api/contact.php" method="POST" novalidate>
            
            <!-- Full Name -->
            <div class="form-group">
              <label for="name" class="voice-1 form-label">Full Name <span class="required-mark">*</span></label>
              <input type="text" id="name" name="name" class="form-control voice-2" required autocomplete="name" placeholder="Your full name">
              <div class="form-error voice-3" id="error-name">Please provide your full name.</div>
            </div>
            
            <!-- Email address -->
            <div class="form-group">
              <label for="email" class="voice-1 form-label">Email address <span class="required-mark">*</span></label>
              <input type="email" id="email" name="email" class="form-control voice-2" required autocomplete="email" placeholder="you@example.com">
              <div class="form-error voice-3" id="error-email">Please provide a valid email address.</div>
            </div>

            <!-- What is your inquiry about? -->
            <div class="form-group">
              <label for="inquiry-type" class="voice-1 form-label">What is your inquiry about? <span class="required-mark">*</span></label>
              <div class="select-wrapper">
                <select id="inquiry-type" name="inquiry_type" class="form-control voice-2 select-control" required>
                  <option value="" disabled selected>Select an inquiry type</option>
                  <option value="Organization inquiry">Organization inquiry</option>
                  <option value="Collaboration or referral">Collaboration or referral</option>
                  <option value="Workshop, training or speaking">Workshop, training or speaking</option>
                  <option value="Venture Readiness Check-In support">Venture Readiness Check-In support</option>
                  <option value="General inquiry">General inquiry</option>
                </select>
              </div>
              <div class="form-error voice-3" id="error-type">Please select an inquiry type.</div>
            </div>
            
            <!-- CONDITIONAL: Organization Fields (Shown when Organization inquiry OR Workshop, training or speaking is selected) -->
            <div id="cond-organization" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-lg); margin-bottom: var(--space-lg); border: 1px solid var(--color-quiet-rule); border-left: 3px solid var(--color-deep-teal); border-radius: 2px;">
              <!-- Organization -->
              <div class="form-group" style="margin-bottom: var(--space-md);">
                <label for="organization" class="voice-1 form-label">Organization <span class="required-mark">*</span></label>
                <input type="text" id="organization" name="organization" class="form-control voice-2" placeholder="Your organization name">
                <div class="form-error voice-3" id="error-organization">Please provide your organization name.</div>
              </div>
              
              <!-- Role -->
              <div class="form-group" style="margin-bottom: 0;">
                <label for="role" class="voice-1 form-label">Your role <span class="required-mark">*</span></label>
                <input type="text" id="role" name="role" class="form-control voice-2" placeholder="Your role or title">
                <div class="form-error voice-3" id="error-role">Please provide your role.</div>
              </div>
            </div>
            
            <!-- CONDITIONAL: Check-In Support Field (Shown when Venture Readiness Check-In support is selected) -->
            <div id="cond-checkin" style="display: none; background-color: var(--color-quiet-sand); padding: var(--space-lg); margin-bottom: var(--space-lg); border: 1px solid var(--color-quiet-rule); border-left: 3px solid var(--color-deep-teal); border-radius: 2px;">
              <div class="form-group" style="margin-bottom: var(--space-xs);">
                <label for="checkin-issue" class="voice-1 form-label">What do you need help with? <span class="required-mark">*</span></label>
                <div class="select-wrapper">
                  <select id="checkin-issue" name="checkin_issue" class="form-control voice-2 select-control">
                    <option value="" disabled selected>Select an option</option>
                    <option value="I did not receive my result">I did not receive my result</option>
                    <option value="A link did not work">A link did not work</option>
                    <option value="I think my result was processed incorrectly">I think my result was processed incorrectly</option>
                    <option value="I have a privacy or data question">I have a privacy or data question</option>
                    <option value="Something else">Something else</option>
                  </select>
                </div>
                <div class="form-error voice-3" id="error-checkin-issue">Please select an option.</div>
              </div>
              
              <p class="voice-2 form-help" style="margin-top: 8px; margin-bottom: 0; font-size: 0.9375rem; color: var(--color-muted-slate); line-height: 1.5;">
                Use the email address you submitted with the Check-In. You do not need to resend your answers.
              </p>
            </div>
            
            <!-- Briefly describe your inquiry (Shown for all inquiry types) -->
            <div class="form-group">
              <label for="description" class="voice-1 form-label">Briefly describe your inquiry <span class="required-mark">*</span></label>
              <textarea id="description" name="description" class="form-control voice-2" rows="5" required placeholder="Describe what you would like to discuss..."></textarea>
              <p class="voice-2 form-help" style="margin-top: 8px; font-size: 0.9375rem; color: var(--color-muted-slate); line-height: 1.5;">
                Share enough context for an initial conversation. Please leave out sensitive personal information, financial records and confidential documents.
              </p>
              <div class="form-error voice-3" id="error-description">Please describe your inquiry.</div>
            </div>
            
            <!-- Privacy notice text -->
            <div style="margin-bottom: var(--space-lg); padding-top: var(--space-xs);">
              <p class="voice-2" style="font-size: 0.9375rem; line-height: 1.55; color: var(--color-deep-body-ink); margin: 0;">
                Ethnoir uses your information to review and respond to your inquiry. Read the <a href="/privacy" style="color: var(--color-deep-teal); text-decoration: underline;">Privacy Notice</a>. Submitting this form does not subscribe you to marketing emails.
              </p>
            </div>
            
            <!-- Submit Button -->
            <div class="form-actions" style="display: flex; flex-direction: column; gap: var(--space-sm);">
              <button type="submit" id="submit-btn" class="btn-primary" style="background-color: var(--color-tidal-ink); color: var(--color-porcelain); border: none; cursor: pointer; text-align: left; align-self: flex-start; padding: var(--space-sm) var(--space-xl); font-size: 1rem; border-radius: 2px;">
                Send inquiry &rarr;
              </button>
              <p class="voice-3" id="submit-status" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0; min-height: 1.5em;"></p>
            </div>
            
            <!-- Hidden Honeypot Spam-Trap Field (must stay invisible) -->
            <div style="display: none;" aria-hidden="true">
              <label for="website_url">Website URL (leave blank)</label>
              <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
            </div>
            
          </form>
        </div>
      </div>

      <!-- Right Column: Booking Panel (Beside the form on desktop; below it on mobile) -->
      <div class="col-12 lg-col-5 padding-left-md">
        <div class="booking-panel" style="background-color: var(--color-parchment); border: 1px solid var(--color-quiet-rule); border-top: 3px solid var(--color-deep-teal); padding: clamp(var(--space-lg), 3vw, var(--space-xl)); border-radius: 2px; position: sticky; top: 100px;">
          <h2 class="voice-1" style="font-size: 1.625rem; color: var(--color-tidal-ink); margin: 0 0 var(--space-sm) 0; line-height: 1.2;">
            Prefer a conversation?
          </h2>
          <p class="voice-2" style="font-size: 1.0625rem; line-height: 1.6; color: var(--color-deep-body-ink); margin: 0 0 var(--space-lg) 0;">
            Book a 30-minute introductory call to explore your needs and whether Ethnoir could help.
          </p>
          
          <div style="display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-lg);">
            <a
              href="https://calendar.app.google/XRqNf4iF8RBDhsaE9"
              target="_blank"
              rel="noopener noreferrer"
              class="booking-card-link"
              style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); padding: 14px 18px; background-color: var(--color-porcelain); border: 1px solid var(--color-quiet-rule); color: var(--color-tidal-ink); text-decoration: none; border-radius: 2px; font-weight: 500; font-size: 0.9375rem; transition: border-color 0.2s ease, transform 0.15s ease;"
            >
              <span>Discuss an organizational challenge or partnership</span>
              <span aria-hidden="true" style="color: var(--color-deep-teal); font-weight: 600;">&rarr;</span>
            </a>
            
            <a
              href="https://calendar.app.google/H9RnDp3z45nM7LDb7"
              target="_blank"
              rel="noopener noreferrer"
              class="booking-card-link"
              style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); padding: 14px 18px; background-color: var(--color-porcelain); border: 1px solid var(--color-quiet-rule); color: var(--color-tidal-ink); text-decoration: none; border-radius: 2px; font-weight: 500; font-size: 0.9375rem; transition: border-color 0.2s ease, transform 0.15s ease;"
            >
              <span>Discuss a workshop, training or speaking engagement</span>
              <span aria-hidden="true" style="color: var(--color-deep-teal); font-weight: 600;">&rarr;</span>
            </a>
          </div>
          
          <p class="voice-3" style="font-size: 0.8125rem; line-height: 1.55; color: var(--color-muted-slate); margin: 0; padding-top: var(--space-sm); border-top: 1px solid var(--color-quiet-rule);">
            Booking opens in Google Calendar. For Check-In support or general questions, please use the form.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION C: BELOW THE FORM AND BOOKING PANEL -->
  <section class="bg-parchment chapter chapter-moderate-spacing" style="border-top: 1px solid var(--color-strong-boundary);">
    <div class="container grid-12">
      <div class="col-12 md-col-4 lg-col-3" style="margin-bottom: var(--space-sm);">
        <h2 class="voice-1" style="font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--color-tidal-ink); line-height: 1.15; margin: 0;">
          What happens next?
        </h2>
      </div>
      
      <div class="col-12 md-col-8 lg-col-9">
        <div style="border-left: 1px solid var(--color-strong-boundary); padding-left: clamp(var(--space-md), 3vw, var(--space-xl)); max-width: 760px;">
          <p class="voice-2" style="font-size: 1.125rem; margin-bottom: var(--space-md); color: var(--color-deep-body-ink); line-height: 1.65;">
            Ethnoir will review your message and may follow up to clarify your needs or discuss a next step. Any engagement requires a separately agreed scope and terms.
          </p>
          <p class="voice-2" style="font-size: 1.0625rem; margin: 0; color: var(--color-tidal-ink); font-weight: 500; line-height: 1.5;">
            Prefer email? <a href="mailto:omichael@ethnoirconsulting.com" style="color: var(--color-deep-teal); text-decoration: underline;">omichael@ethnoirconsulting.com</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Form Styles */
  .form-group {
    margin-bottom: var(--space-lg);
  }
  
  .form-label {
    display: block;
    font-size: 1.125rem;
    color: var(--color-tidal-ink);
    margin-bottom: 6px;
    font-weight: 600;
  }
  
  .required-mark {
    color: #D93838;
  }
  
  .form-control {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--color-parchment);
    border: 1px solid var(--color-strong-boundary);
    font-size: 1rem;
    font-family: var(--font-body);
    color: var(--color-tidal-ink);
    border-radius: 2px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  
  .form-control:focus {
    outline: none;
    border-color: var(--color-deep-teal);
    box-shadow: 0 0 0 2px rgba(13, 98, 100, 0.2);
  }
  
  .form-control.is-invalid {
    border-color: #D93838;
    background-color: #FDF4F4;
  }
  
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  
  .select-control {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230D6264' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 16px;
    padding-right: 40px;
  }
  
  .form-error {
    display: none;
    color: #D93838;
    font-size: 0.875rem;
    margin-top: 6px;
  }
  
  .booking-card-link:hover {
    border-color: var(--color-deep-teal) !important;
    background-color: #FAF6EF !important;
  }

  @media (min-width: 992px) {
    .padding-left-md {
      padding-left: var(--space-xl);
    }
  }

  @media (max-width: 991px) {
    .booking-panel {
      position: static !important;
      margin-top: var(--space-lg);
    }
  }
</style>

<script>
  // Form Interaction Logic
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ethnoir-contact-form') as HTMLFormElement;
    const inquiryTypeSelect = document.getElementById('inquiry-type') as HTMLSelectElement;
    
    // Conditional containers
    const condOrganization = document.getElementById('cond-organization');
    const condCheckin = document.getElementById('cond-checkin');
    
    // Conditional inputs
    const orgInput = document.getElementById('organization') as HTMLInputElement;
    const roleInput = document.getElementById('role') as HTMLInputElement;
    const checkinSelect = document.getElementById('checkin-issue') as HTMLSelectElement;
    
    // Submit state elements
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitStatus = document.getElementById('submit-status');
    const successMessage = document.getElementById('form-success-message');
    const errorSummary = document.getElementById('form-error-summary');
    const errorText = document.getElementById('form-error-text');

    const updateConditionalDisplay = () => {
      const val = inquiryTypeSelect ? inquiryTypeSelect.value : '';
      
      // Reset conditional states
      if (orgInput) {
        orgInput.required = false;
        orgInput.classList.remove('is-invalid');
      }
      if (roleInput) {
        roleInput.required = false;
        roleInput.classList.remove('is-invalid');
      }
      if (condOrganization) condOrganization.style.display = 'none';
      
      if (checkinSelect) {
        checkinSelect.required = false;
        checkinSelect.classList.remove('is-invalid');
      }
      if (condCheckin) condCheckin.style.display = 'none';
      
      // SHOW Organization & Role when "Organization inquiry" OR "Workshop, training or speaking" is selected
      if (val === 'Organization inquiry' || val === 'Workshop, training or speaking') {
        if (condOrganization) condOrganization.style.display = 'block';
        if (orgInput) orgInput.required = true;
        if (roleInput) roleInput.required = true;
      } 
      // SHOW Check-In support field when "Venture Readiness Check-In support" is selected
      else if (val === 'Venture Readiness Check-In support') {
        if (condCheckin) condCheckin.style.display = 'block';
        if (checkinSelect) checkinSelect.required = true;
      }
    };

    if (inquiryTypeSelect) {
      inquiryTypeSelect.addEventListener('change', updateConditionalDisplay);
    }

    // Handle URL query parameter pre-selection
    const urlParams = new URLSearchParams(window.location.search);
    const typeParam = urlParams.get('type');
    if (typeParam && inquiryTypeSelect) {
      const lower = typeParam.toLowerCase();
      if (lower.includes('org') || lower.includes('inst')) {
        inquiryTypeSelect.value = 'Organization inquiry';
      } else if (lower.includes('checkin') || lower.includes('check-in') || lower.includes('support')) {
        inquiryTypeSelect.value = 'Venture Readiness Check-In support';
      } else if (lower.includes('collab')) {
        inquiryTypeSelect.value = 'Collaboration or referral';
      } else if (lower.includes('workshop') || lower.includes('speaking')) {
        inquiryTypeSelect.value = 'Workshop, training or speaking';
      } else if (lower.includes('gen')) {
        inquiryTypeSelect.value = 'General inquiry';
      }
      updateConditionalDisplay();
    }
    
    // Field validation helper
    const validateField = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, errorId: string) => {
      const errorEl = document.getElementById(errorId);
      if (!field.validity.valid || (field.required && !field.value.trim())) {
        field.classList.add('is-invalid');
        if (errorEl) errorEl.style.display = 'block';
        return false;
      } else {
        field.classList.remove('is-invalid');
        if (errorEl) errorEl.style.display = 'none';
        return true;
      }
    };
    
    // Form submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset summary
        if (errorSummary) errorSummary.style.display = 'none';
        
        // Validate all active fields
        let isValid = true;
        isValid = validateField(document.getElementById('name') as HTMLInputElement, 'error-name') && isValid;
        isValid = validateField(document.getElementById('email') as HTMLInputElement, 'error-email') && isValid;
        isValid = validateField(inquiryTypeSelect, 'error-type') && isValid;
        
        if (orgInput && orgInput.required) {
          isValid = validateField(orgInput, 'error-organization') && isValid;
        }
        if (roleInput && roleInput.required) {
          isValid = validateField(roleInput, 'error-role') && isValid;
        }
        
        if (checkinSelect && checkinSelect.required) {
          isValid = validateField(checkinSelect, 'error-checkin-issue') && isValid;
        }
        
        isValid = validateField(document.getElementById('description') as HTMLTextAreaElement, 'error-description') && isValid;
        
        if (!isValid) {
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "Please review the errors below and try again.";
          errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        
        // Set loading state
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        if (submitStatus) submitStatus.textContent = '';
        
        // Submit via AJAX
        try {
          const formData = new FormData(form);
          
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          const result = await response.json();
          
          if (response.ok && result.success) {
            // Success state
            form.style.display = 'none';
            if (successMessage) {
              successMessage.style.display = 'block';
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          } else {
            // Server error state
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send inquiry →';
            if (errorSummary) errorSummary.style.display = 'block';
            if (errorText) errorText.textContent = result.message || "There was a problem with your submission. Please review the errors below and try again.";
            errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } catch (err) {
          // Network error state
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send inquiry →';
          if (errorSummary) errorSummary.style.display = 'block';
          if (errorText) errorText.textContent = "There was a problem with your submission. Please review the errors below and try again.";
          errorSummary?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }
  });
</script>
