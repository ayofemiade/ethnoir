---
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Ethnoir helps founders navigate ventures and organizations shape entrepreneurship support.',
  canonical,
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title.includes('Ethnoir') ? title : `${title} | Ethnoir`;
const canonicalURL = canonical || new URL(currentPath, Astro.site || 'https://ethnoir.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ethnoir" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preload Critical Heading & Body Fonts for Instant First Contentful Paint -->
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="//tally.so" />
    <link rel="preconnect" href="https://tally.so" crossorigin />
  </head>
  <body>
    <div class="site-container">
      <header class="site-header container">
        <a href="/" class="brand-link" aria-label="Ethnoir Home" style="text-decoration: none;">
          <span style="font-family: var(--font-heading); font-size: 1.75rem; line-height: 1; color: var(--color-tidal-ink); letter-spacing: -0.02em;">Ethnoir</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="site-nav desktop-nav" aria-label="Main Navigation">
          <a href="/about" class={currentPath === '/about' ? 'active' : ''}>
            About
          </a>
          <a
            href="/for-organizations"
            class={currentPath === '/for-organizations' ? 'active' : ''}
          >
            For Organizations
          </a>
          <a
            href="/our-work"
            class={currentPath.startsWith('/our-work') ? 'active' : ''}
          >
            Our Work
          </a>
          <a
            href="/venture-readiness-check-in"
            class={
              currentPath === '/venture-readiness-check-in' ? 'active' : ''
            }
          >
            Check-In
          </a>
          <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>
            Contact
          </a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="mobile-menu-btn"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label="Toggle navigation menu"
        >
          <span class="menu-icon-box" aria-hidden="true">
            <span class="menu-bar bar-top"></span>
            <span class="menu-bar bar-bottom"></span>
          </span>
          <span class="menu-label">Menu</span>
        </button>
      </header>

      <!-- Mobile Navigation Drawer & Backdrop -->
      <div id="mobile-nav-backdrop" class="mobile-nav-backdrop" aria-hidden="true"></div>
      <aside id="mobile-nav-drawer" class="mobile-nav-drawer" aria-label="Mobile Navigation" aria-hidden="true">
        <div class="drawer-header">
          <span class="drawer-brand">Ethnoir</span>
          <button
            type="button"
            class="drawer-close-btn"
            id="mobile-menu-close"
            aria-label="Close navigation menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <nav class="drawer-nav">
          <a href="/" class={`drawer-link ${currentPath === '/' ? 'active' : ''}`}>
            <span class="drawer-link-title">Home</span>
            <span class="drawer-link-desc">Overview & Focus</span>
          </a>
          <a href="/about" class={`drawer-link ${currentPath === '/about' ? 'active' : ''}`}>
            <span class="drawer-link-title">About</span>
            <span class="drawer-link-desc">Background, Lead & Values</span>
          </a>
          <a href="/for-organizations" class={`drawer-link ${currentPath === '/for-organizations' ? 'active' : ''}`}>
            <span class="drawer-link-title">For Organizations</span>
            <span class="drawer-link-desc">Program Advisory & Support</span>
          </a>
          <a href="/our-work" class={`drawer-link ${currentPath.startsWith('/our-work') ? 'active' : ''}`}>
            <span class="drawer-link-title">Our Work</span>
            <span class="drawer-link-desc">Past Initiatives & Delivery</span>
          </a>
          <a href="/venture-readiness-check-in" class={`drawer-link ${currentPath === '/venture-readiness-check-in' ? 'active' : ''}`}>
            <span class="drawer-link-title">Venture Readiness Check-In</span>
            <span class="drawer-link-desc">Self-Assessment for Founders</span>
          </a>
          <a href="/contact" class={`drawer-link ${currentPath === '/contact' ? 'active' : ''}`}>
            <span class="drawer-link-title">Contact</span>
            <span class="drawer-link-desc">Inquiries & Discussions</span>
          </a>
        </nav>

        <div class="drawer-footer">
          <a href="/venture-readiness-check-in" class="drawer-cta-primary">
            Start the Check-In &rarr;
          </a>
        </div>
      </aside>

      <main>
        <slot />
      </main>

      <footer class="site-footer container">
        <div class="footer-content" style="display: flex; flex-direction: column; gap: var(--space-md); border-top: 1px solid var(--color-quiet-rule); padding-top: var(--space-lg);">
          <div style="display: flex; flex-direction: column; gap: var(--space-xs); max-width: 680px;">
            <a href="/" aria-label="Ethnoir Home" style="text-decoration: none; width: fit-content;">
              <span style="font-family: var(--font-heading); font-size: 1.75rem; line-height: 1; color: var(--color-tidal-ink); letter-spacing: -0.02em;">Ethnoir</span>
            </a>
            <p class="voice-2" style="font-size: 1.0625rem; line-height: 1.5; color: var(--color-deep-body-ink); margin: 0;">
              Ethnoir helps founders and the organizations that support them understand what a business needs next.
            </p>
            <p class="voice-3" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0;">
              Ethnoir LLC &middot; Winston-Salem, North Carolina
            </p>
          </div>
          
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md); padding-top: var(--space-sm); border-top: 1px solid var(--color-quiet-rule);">
            <nav class="footer-links" aria-label="Footer Navigation" style="display: flex; flex-wrap: wrap; gap: var(--space-md);">
              <a href="/about" style="color: var(--color-tidal-ink); text-decoration: none;">About</a>
              <a href="/for-organizations" style="color: var(--color-tidal-ink); text-decoration: none;">For Organizations</a>
              <a href="/our-work" style="color: var(--color-tidal-ink); text-decoration: none;">Our Work</a>
              <a href="/venture-readiness-check-in" style="color: var(--color-tidal-ink); text-decoration: none;">Check-In</a>
              <a href="/contact" style="color: var(--color-tidal-ink); text-decoration: none;">Contact</a>
              <a href="/privacy" style="color: var(--color-tidal-ink); text-decoration: none;">Privacy Notice</a>
            </nav>
            <p class="copyright voice-3" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0;">
              &copy; 2026 Ethnoir LLC.
            </p>
          </div>
        </div>
      </footer>
    </div>

    <script>
      function initMobileNav() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-menu-close');
        const drawer = document.getElementById('mobile-nav-drawer');
        const backdrop = document.getElementById('mobile-nav-backdrop');
        const drawerLinks = drawer?.querySelectorAll('.drawer-link');

        if (!toggleBtn || !drawer || !backdrop) return;

        function openMenu() {
          toggleBtn.setAttribute('aria-expanded', 'true');
          drawer.setAttribute('aria-hidden', 'false');
          backdrop.classList.add('is-open');
          drawer.classList.add('is-open');
          toggleBtn.classList.add('is-active');
          document.body.classList.add('menu-open');
        }

        function closeMenu() {
          toggleBtn.setAttribute('aria-expanded', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          backdrop.classList.remove('is-open');
          drawer.classList.remove('is-open');
          toggleBtn.classList.remove('is-active');
          document.body.classList.remove('menu-open');
        }

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
          isOpen ? closeMenu() : openMenu();
        });

        closeBtn?.addEventListener('click', closeMenu);
        backdrop.addEventListener('click', closeMenu);

        drawerLinks?.forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            closeMenu();
            toggleBtn.focus();
          }
        });
      }

      initMobileNav();
      document.addEventListener('astro:after-swap', initMobileNav);
    </script>
  </body>
</html>
