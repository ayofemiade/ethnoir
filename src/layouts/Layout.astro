---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Ethnoir helps founders navigate ventures and organizations shape entrepreneurship support.',
  canonical,
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title.includes('Ethnoir') ? title : `${title} | Ethnoir`;
const canonicalURL = canonical || new URL(currentPath, Astro.site || 'https://ethnoir.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ethnoir" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preload fonts (optional, as fontsource handles standard local woff2 serving) -->
  </head>
  <body>
    <div class="site-container">
      <header class="site-header container">
        <a href="/" class="brand-link" aria-label="Ethnoir Home" style="text-decoration: none;">
          <span style="font-family: var(--font-heading); font-size: 2rem; line-height: 1; color: var(--color-tidal-ink); letter-spacing: -0.02em;">Ethnoir</span>
        </a>
        <nav class="site-nav" aria-label="Main Navigation">
          <a href="/about" class={currentPath === '/about' ? 'active' : ''}>
            About
          </a>
          <a
            href="/for-organizations"
            class={currentPath === '/for-organizations' ? 'active' : ''}
          >
            For Organizations
          </a>
          <a
            href="/our-work"
            class={currentPath.startsWith('/our-work') ? 'active' : ''}
          >
            Our Work
          </a>
          <a
            href="/venture-readiness-check-in"
            class={
              currentPath === '/venture-readiness-check-in' ? 'active' : ''
            }
          >
            Check-In
          </a>
          <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>
            Contact
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer container">
        <div class="footer-content" style="display: flex; flex-direction: column; gap: var(--space-md); border-top: 1px solid var(--color-quiet-rule); padding-top: var(--space-lg);">
          <div style="display: flex; flex-direction: column; gap: var(--space-xs); max-width: 680px;">
            <a href="/" aria-label="Ethnoir Home" style="text-decoration: none; width: fit-content;">
              <span style="font-family: var(--font-heading); font-size: 1.75rem; line-height: 1; color: var(--color-tidal-ink); letter-spacing: -0.02em;">Ethnoir</span>
            </a>
            <p class="voice-2" style="font-size: 1.0625rem; line-height: 1.5; color: var(--color-deep-body-ink); margin: 0;">
              Ethnoir helps founders and the organizations that support them understand what a business needs next.
            </p>
            <p class="voice-3" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0;">
              Ethnoir LLC &middot; Winston-Salem, North Carolina
            </p>
          </div>
          
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md); padding-top: var(--space-sm); border-top: 1px solid var(--color-quiet-rule);">
            <nav class="footer-links" aria-label="Footer Navigation" style="display: flex; flex-wrap: wrap; gap: var(--space-md);">
              <a href="/about" style="color: var(--color-tidal-ink); text-decoration: none;">About</a>
              <a href="/for-organizations" style="color: var(--color-tidal-ink); text-decoration: none;">For Organizations</a>
              <a href="/our-work" style="color: var(--color-tidal-ink); text-decoration: none;">Our Work</a>
              <a href="/venture-readiness-check-in" style="color: var(--color-tidal-ink); text-decoration: none;">Check-In</a>
              <a href="/contact" style="color: var(--color-tidal-ink); text-decoration: none;">Contact</a>
              <a href="/privacy" style="color: var(--color-tidal-ink); text-decoration: none;">Privacy Notice</a>
            </nav>
            <p class="copyright voice-3" style="font-size: 0.875rem; color: var(--color-muted-slate); margin: 0;">
              &copy; 2026 Ethnoir LLC.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
